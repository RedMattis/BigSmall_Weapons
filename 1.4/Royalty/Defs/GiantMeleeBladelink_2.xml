    <weaponTags>
      <li>UltratechMeleeGiant_Cold</li>
    </weaponTags>
    <graphicData>
      <texPath>BS_Weapons/CryptoGreataxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>2.35</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <statBases>
      <Mass>15</Mass>
    </statBases>
    <equippedAngleOffset>-20</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>25</power>
        <cooldownTime>2.8</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Frostbite</def>
            <amount>16</amount>
            <chance>1</chance>
          </li>
        </extraMeleeDamages>
      </li>
    </tools>
		<possessionCount>1</possessionCount>
		<rotateInShelves>false</rotateInShelves>
		<tradeability>Sellable</tradeability>
	</ThingDef>
</Defs>