      <li>MedievalMeleeGiant</li>
    </weaponTags>
    <weaponClasses Inherit="False">
      <li>BS_GiantWeapon</li>
    </weaponClasses>
    <costStuffCount>135</costStuffCount>
    <statBases>
      <WorkToMake>1800</WorkToMake>
      <Mass>15</Mass>
    </statBases>
    <equippedStatOffsets>
      <GeneralLaborSpeed>0.15</GeneralLaborSpeed>
      <ConstructionSpeed>0.25</ConstructionSpeed>
      <ConstructSuccessChance>0.12</ConstructSuccessChance>
    </equippedStatOffsets>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <recipeMaker>
      <researchPrerequisite>Smithing</researchPrerequisite>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <displayPriority>440</displayPriority>
    </recipeMaker>
    <stuffCategories>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <tools>
      <li>
        <label>head</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>17</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
		<possessionCount>1</possessionCount>
		<rotateInShelves>false</rotateInShelves>
		<relicChance>0.1</relicChance>
		<tradeability>Sellable</tradeability>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
	</ThingDef>

