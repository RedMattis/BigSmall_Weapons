<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Blunt">
    <defName>BS_GiantMedievalHammer</defName>
    <label>giant hammer</label>
    <description>A huge one-handed hammer which is too unwieldly for normal person to use.</description>
    <graphicData>
      <texPath>BS_Weapons/GiantMedievalHammer</texPath>
      <maskPath>BS_Weapons/GiantMedievalHammer_m</maskPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.62</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Medieval</techLevel>
