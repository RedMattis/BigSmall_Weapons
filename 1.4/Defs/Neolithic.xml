<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>BS_GiantSalvageClub</defName>
    <label>giant salvage club</label>
    <description>A giant club with a bunch of sharp metal pieces stuck in it.</description>
    <graphicData>
      <texPath>BS_Weapons/GiantSalvageSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>3.2</drawSize>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
    <techLevel>Neolithic</techLevel>
    <weaponTags Inherit="False">
      <li>NeolithicMeleeGiant</li>
    </weaponTags>
    <weaponClasses Inherit="False">
      <li>BS_GiantWeapon</li>
    </weaponClasses>
    <statBases>
      <WorkToMake>1800</WorkToMake>
      <Mass>15</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <costList>
      <Steel>100</Steel>
      <WoodLog>75</WoodLog>
    </costList>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
      <displayPriority>300</displayPriority>
    </recipeMaker>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>head</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>22</power>
        <cooldownTime>2.85</cooldownTime>
      </li>
      <li>
        <label>head</label>
        <labelUsedInLogging>false</labelUsedInLogging>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>22</power>
        <cooldownTime>2.85</cooldownTime>
      </li>
    </tools>
		<possessionCount>1</possessionCount>
		<rotateInShelves>false</rotateInShelves>
		<relicChance>0.1</relicChance>
		<tradeability>Sellable</tradeability>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
	</ThingDef>

